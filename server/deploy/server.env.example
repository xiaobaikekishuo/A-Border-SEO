# Root-owned mode 0600. Use simple KEY=value lines, or JSON double-quoted values.
# Preserve NEXTAUTH_SECRET exactly when moving existing encrypted provider data.
NODE_ENV=production
ABORDER_HOSTED=1
NEXTAUTH_URL=https://aborder.tuitehao.shop
NEXTAUTH_SECRET=REPLACE_WITH_ORIGINAL_OR_NEW_RANDOM_SECRET
AUTH_TRUST_HOST=true
DATABASE_URL=postgresql://aborder:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/aborder?connection_limit=4&pool_timeout=20
# Pool budget: app 4 + worker 4. With PostgreSQL max_connections=30, keep the
# remaining slots for tooling/admin; include every extra process or replica
# in the total. Preserve existing schema/SSL parameters when updating the URL.
ABORDER_CONTROL_INTERNAL_URL=http://127.0.0.1:18086
ABORDER_CONTROL_INTERNAL_SECRET=REPLACE_WITH_SAME_DEDICATED_INTERNAL_SECRET
# Optional only if PostgreSQL 16 client executables have another installation path.
ABORDER_PG_BIN=/usr/lib/postgresql/16/bin
# Preserve Google OAuth, Bing, SMTP and other application settings as appropriate.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
