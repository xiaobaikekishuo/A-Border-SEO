FROM node:24-bookworm-slim
ARG RELEASE_VERSION
LABEL com.aborder-seo.role="control-plane" com.aborder-seo.version="${RELEASE_VERSION}"
WORKDIR /app
COPY control-plane/ /app/control-plane/
COPY source/lib/managed/protocol.mjs /app/source/lib/managed/protocol.mjs
COPY control-backup.mjs smoke.mjs /tools/
RUN mkdir -p /data /run/secrets && chown 10001:10001 /data
USER 10001:10001
ENTRYPOINT []
CMD ["node", "/app/control-plane/server.mjs"]
