# A-Border SEO 配置示例。复制为 .env 后填写。
# Windows 本地部署请用 windows/ 套件：它会自动生成 .env，不需要手动复制本文件。

# ============ 必填 ============
# 本地开发（npm run dev）使用的数据库。docker-compose.yml 会按下面的 POSTGRES_* 自行拼出连接串。
DATABASE_URL=postgresql://aborder:changeme@localhost:5432/aborder

# ============ Docker Compose ============
# docker-compose.yml 使用的数据库账号。服务器上请换成随机密码。
POSTGRES_USER=aborder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aborder
# 镜像名（docker compose up --build 会用这个名字构建）；改成镜像仓库地址可直接拉取发布版本
# ABORDER_SEO_IMAGE=a-border-seo:1.1.2
# 主机上的端口：应用默认 3000，数据库只绑定 127.0.0.1，默认 5432
# APP_PORT=3000
# DB_PORT=5432

# ============ Google OAuth（Search Console 数据必需） ============
# 在 https://console.cloud.google.com/ 创建 Web 应用类型的 OAuth 客户端。
# 需要的权限：openid、email、profile、https://www.googleapis.com/auth/webmasters.readonly
# 回调地址：<NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# 可选：PageSpeed Insights API Key（Core Web Vitals 检查的配额更高）
# GOOGLE_PAGESPEED_KEY=

# 可选：访问 Google 时使用的本机 HTTP 代理，只影响 Google 请求。
# 只接受 localhost、127.0.0.1、[::1] 或 host.docker.internal，不能带用户名、密码或路径。
# GOOGLE_HTTP_PROXY=http://host.docker.internal:7890
# Optional local proxy for ChatGPT account authorization, models and requests.
# OPENAI_HTTP_PROXY=http://host.docker.internal:7890
# 可选：Manus API 专用的本机 HTTP 代理，地址格式与 GOOGLE_HTTP_PROXY 相同。
# MANUS_HTTP_PROXY=http://host.docker.internal:7890

# ============ 登录（Auth.js） ============
# 用户在浏览器里打开的地址。服务器上填 https 地址（例如 https://seo.example.com）。
NEXTAUTH_URL=http://localhost:3000
# 用 openssl rand -hex 32 生成。生成后不要更改：它同时加密保存的 API Key 和 Google 令牌。
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
# 在反向代理（如 Nginx、Caddy、Coolify）后面运行时需要
AUTH_TRUST_HOST=true
# AUTH_SECRET 是 NEXTAUTH_SECRET 的别名（Auth.js v5 的名称），两者都设置时以 NEXTAUTH_SECRET 为准。
# AUTH_SECRET=

# ============ 可选：抓取 ============
# 单次抓取的最长时间（分钟，默认 30）。多见于 robots.txt 设置了 Crawl-delay 的站点：
# 抓取会按要求逐个请求，并报告因此提前停止的主机。
# CRAWL_MAX_MINUTES=30
# 单次抓取最多的页面数（默认 2000）。服务器对每次抓取都执行这个上限。
# CRAWL_MAX_PAGES=2000
# 保留最近几次已完成抓取的页面正文、标题结构和结构化数据明细（2 到 100，默认 3）。
# 更早的抓取只保留标题、状态码、问题、链接和评分。
# CRAWL_DETAIL_RETENTION=3
# 抓取使用的 User-Agent。robots.txt 按第一个“/”之前的产品标识匹配，修改时保留它。
# CRAWLER_USER_AGENT=ABorderSEOBot/1.0 (+https://your-site.example/bot)

# ============ 可选：只读 API（/api/v1）与 MCP ============
# 每个访问密钥每分钟的请求数（默认 60，按进程计）。
# API_RATE_LIMIT_PER_MINUTE=60

# ============ 可选：后台任务 ============
# 谁来执行排队的抓取、性能检查和同步：inline（默认，应用进程）、off（只排队，由 worker 执行）
# 或 worker（worker 进程）。docker-compose.yml 为应用设 off，为 worker 设 worker。
# WORKER_MODE=inline
# WORKER_LONG_CONCURRENCY=1
# WORKER_SHORT_CONCURRENCY=2
# WORKER_POLL_SECONDS=5
# WORKER_SHUTDOWN_GRACE_SECONDS=25
# JOB_STALE_SECONDS=180
# JOB_RETENTION_DAYS=30

# 计划任务：每个站点每天同步，每周抓取和检查性能。0 关闭其中一项；SCHEDULER_ENABLED=false 全部关闭。
# 用户可在“设置 → 定时任务”调整自己站点的抓取和性能检查间隔；这里是默认值，0 对所有人关闭。
# SCHEDULER_ENABLED=true
# SCHEDULE_GSC_SYNC_HOURS=24
# SCHEDULE_BING_SYNC_HOURS=24
# SCHEDULE_CRAWL_DAYS=7
# SCHEDULE_VITALS_DAYS=7
# 提示词跟踪的定期运行（间隔由每个站点在 GEO 监测中设置，默认只手动运行）。false 对所有站点关闭。
# SCHEDULE_GEO_TRACKING=true

# 仅 Vercel：保护 /api/cron/tick，16 个字符以上的随机字符串。
# CRON_SECRET=

# ============ 可选：告警回调 ============
# 用户可把触发的告警发到自己的地址（“设置 → 告警 Webhook”）。false 对整个实例关闭。
# ALERT_WEBHOOKS_ENABLED=true
# 回调默认只发往公网地址。true 时也允许私有网络（10/8、172.16/12、192.168/16、100.64/10、
# 本机回环、fc00::/7），例如同一网络里的 n8n。链路本地地址始终禁止。
# ALERT_WEBHOOK_ALLOW_PRIVATE=false

# ============ 可选：告警邮件 ============
# 通过你自己的 SMTP 服务器发送告警邮件（“设置 → 邮件告警”）。设置了 SMTP_HOST 和 SMTP_FROM 才启用。
# 登录信息只保存在这里，不写入数据库，也不会显示或记录到日志。
# SMTP_HOST=smtp.example.com
# 默认 587；SMTP_SECURE=true 时用 465。
# SMTP_PORT=587
# true：从连接开始就用 TLS（465 端口）。false：服务器支持时使用 STARTTLS。
# SMTP_SECURE=false
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=
# SMTP_FROM="SEO Alerts <alerts@example.com>"
# false 对整个实例关闭告警邮件。
# ALERT_EMAILS_ENABLED=true

# ============ 可选：注册 ============
# 创建好自己的管理员账号后设为 true，阻止新用户注册。已有用户照常登录；从未在此登录过的 Google 账号会被拒绝。
# DISABLE_REGISTRATION=false
# 登录页对被拒绝账号显示的文字。纯文本，最多 200 个字符；不设置时显示默认文字。
# REGISTRATION_CLOSED_MESSAGE="This instance is not accepting new accounts. Ask its owner to sign you up."

# ============ 可选：本地 AI 写作 ============
# 浏览器访问本地应用的端口（ChatGPT 连接的回调地址用到它，默认 3300）。改动后需在后台断开并重新连接 ChatGPT。
# LOCAL_APP_PORT=3300
# 本地内容 Worker 的令牌（至少 32 个字符），worker 用它领取“Codex 本地执行”的任务。
# 生成：node local-worker/index.mjs --generate-token
# LOCAL_CONTENT_WORKER_TOKEN=

# ============ 可选：新版本提示 ============
# 填写发布本应用版本的 GitHub 仓库（owner/name）后，服务器每天查询一次最新版本（请求只带
# User-Agent “a-border-seo/<版本>”，不含任何你的数据），较新时在侧边栏提示。不填则从不查询。
# UPDATE_CHECK_REPO=
# 设置了仓库也想暂时关闭时设为 false。
# UPDATE_CHECK=true

# ============ Node 环境 ============
# NODE_ENV=development
