generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  googleTokens  Json?     // Google OAuth tokens: accessToken and refreshToken encrypted (lib/google/token-store.ts), the rest plain
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  sites         Site[]
  alerts        Alert[]
  apiKeys       ApiKey[]
  accessKeys    AccessKey[]
  settings      UserSettings?
  chatGptProfiles ChatGptProfile[]
  manusKeywordTasks ManusKeywordTask[]
  manusResearchTasks ManusResearchTask[]
  desktopOAuthAttempts DesktopOAuthAttempt[]
  managedIdentity ManagedIdentity?
  hostedDevices HostedDevice[]
  aiPoolSetting AiPoolSetting?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  managedNonceHash String?
  managedInstallationId String?
  hostedDeviceId String?
  hostedBinding String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A management account owns a distinct local user. Never infer this link from
// an email address or transfer another user's existing sites during sign-in.
model ManagedIdentity {
  issuer String
  productId String
  accountId String
  userId String @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issuer, productId, accountId])
}

// Verified control-plane device identity. Raw device credentials never enter this database.
model HostedDevice {
  id String @id @default(cuid())
  issuer String
  productId String
  accountId String
  installationId String
  userId String
  sessionBinding String
  desktopVersion String
  codexLogin Boolean @default(false)
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([issuer, productId, installationId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Before browser sign-in, only the opaque challenge and its expiration exist.
model DesktopLoginChallenge {
  id         String   @id
  challenge  String
  expiresAt  DateTime

  @@index([expiresAt])
}

model DesktopOAuthAttempt {
  id         String   @id
  purpose    String
  challenge  String
  expiresAt  DateTime
  status     String   @default("pending")
  userId     String
  siteId     String?
  report     Json?
  code       String?  // Short-lived encrypted GA4 authorization code

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

// ============ API KEYS (BYOK) ============

model ApiKey {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "dataforseo" (login+password) | "google_pagespeed" | "bing" | "manus" (single key)
  encryptedLogin    String?  // null for single-key providers like google_pagespeed
  encryptedPassword String   // holds the API key itself for single-key providers
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ============ ACCESS KEYS (read-only API and MCP) ============

// A key a user creates to read their own data through /api/v1 (lib/api-v1),
// which the MCP server uses. Only a SHA-256 hash of the key is stored; the
// key itself is shown once, when it is created. Revoking a key deletes it.
model AccessKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique // SHA-256 of the whole key, hex
  prefix     String    // the start of the key, to tell keys apart in Settings
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // updated at most once a minute

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ USER SETTINGS ============

// What a user sets in Settings > Schedule and Settings > Alert webhook.
model UserSettings {
  userId             String   @id
  crawlScheduleDays  Int?     // days between scheduled crawls of each site; null: the server default, 0: off
  vitalsScheduleDays Int?     // the same for vitals checks
  webhookUrl         String?  // encrypted (lib/encryption.ts); null: no webhook
  webhookSecret      String?  // encrypted; signs every delivery
  mcpEnabled         Boolean  @default(false) // Settings > MCP: access keys work only while this is on
  alertEmailTo       String?  // Settings > Email alerts: recipients, comma-separated; null: none
  alertEmailEnabled  Boolean  @default(false) // fired alerts are emailed only while this is on
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ SITES ============

model Site {
  id          String   @id @default(cuid())
  userId      String
  domain      String   // e.g. "quayline.app"
  researchLanguage String @default("en")
  researchLocation Int @default(2840)
  gscProperty String?  // e.g. "sc-domain:quayline.app"
  bingSite    String?  // e.g. "https://quayline.app/" (Bing's own URL form)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gscSyncCoverage GscSyncCoverage[]
  queryPages QueryPage[]
  keywords      Keyword[]
  pages         Page[]
  crawls        Crawl[]
  vitals        VitalsReport[]
  alerts        Alert[]
  savedKeywords SavedKeyword[]
  rankSnapshots RankSnapshot[]
  rankTracking  RankTracking?
  rankRuns      RankRun[]
  rankChecks    RankCheck[]
  bingDaily     BingDaily[]
  bingWeekly    BingSearchWeekly[]
  jobs          Job[]
  contentPillars ContentPillar[]
  contentClusters ContentCluster[]
  contentPlanJobs ContentPlanJob[]
  aiWorkbenchJobs AiWorkbenchJob[]
  aiReportSchedule AiReportSchedule?
  aiAutomation AiAutomation?
  aiBacklogItems AiBacklogItem[]
  geoSnapshots GeoSnapshot[]
  geoTracking  GeoTracking?
  geoPrompts   GeoPrompt[]
  geoRuns      GeoRun[]
  geoAnswers   GeoAnswer[]
  indexNow     IndexNowState?
  trustedSources TrustedSource[]
  manusKeywordTasks ManusKeywordTask[]
  manusResearchTasks ManusResearchTask[]

  @@unique([userId, domain])
}

model ManusKeywordTask {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
  requestId String
  input     Json
  status    String
  remoteId  String?
  taskUrl   String?
  result    String?
  files     Json     @default("[]")
  errorCode String?
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  preview   ManusKeywordPreview?

  @@unique([userId, siteId, requestId])
  @@index([userId, siteId, createdAt, id])
}

/// The weekly AI action list of a site (lib/ai-workbench/weekly-report.ts):
/// from each Monday 00:00 UTC, the owner's local Codex worker writes it on its
/// next poll, and it goes to the owner's alert email and webhook.
model AiReportSchedule {
  siteId    String    @id
  enabled   Boolean   @default(false)
  language  String    @default("zh-CN")
  lastSlot  DateTime? // the Monday 00:00 UTC of the last week handled
  lastJobId String?
  updatedAt DateTime  @updatedAt
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

/// Background Codex work of a user (lib/ai-workbench/pool): off until turned on.
model AiPoolSetting {
  userId         String   @id
  enabled        Boolean  @default(false)
  shortReserve   Int      @default(30) // percent of the short (5-hour) window kept for tasks the user starts
  weeklyReserve  Int      @default(10) // percent of the weekly allowance background tasks never use
  reviewCap      Int      @default(20) // background results waiting for review before the pool pauses
  language       String   @default("zh-CN")
  lightModel     String?
  lightReasoning String?  @default("low")
  mainModel      String?
  mainReasoning  String?  @default("medium")
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// What fills a site's background pool (lib/ai-workbench/pool/fill.ts).
model AiAutomation {
  siteId      String    @id
  rankings    Boolean   @default(false) // review a rank check with notable moves
  alerts      Boolean   @default(false) // diagnose newly fired alerts
  meta        Boolean   @default(false) // rewrite titles and descriptions when low-CTR pages change
  schema      Boolean   @default(false) // structured data for crawled pages without any, new pages first
  clusters    Boolean   @default(false) // monthly search query clusters
  briefs      Boolean   @default(false) // briefs for planned topics without one
  // Tasks of each kind started automatically per site per UTC day (1.9.1).
  rankingsCap Int       @default(2)
  alertsCap   Int       @default(2)
  metaCap     Int       @default(1)
  schemaCap   Int       @default(10)
  clustersCap Int       @default(1)
  briefsCap   Int       @default(5)
  alertsScope String    @default("drops") // drops: traffic and ranking drops only; all: every alert
  markers     Json      @default("{}")    // what the fillers have already seen
  status      Json      @default("{}")    // each filler's last check: when, what it found, what it queued
  filledAt    DateTime?
  updatedAt   DateTime  @updatedAt
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

/// One piece of background work: becomes a workbench task when the worker is idle and the allowance allows.
model AiBacklogItem {
  id         String          @id @default(cuid())
  siteId     String
  source     String          // RANKINGS, ALERTS, META, SCHEMA, CLUSTERS, BRIEF, BATCH
  kind       String          // the workbench task kind it becomes
  title      String
  payload    Json
  dedupeKey  String
  priority   Int
  status     String          @default("PENDING") // PENDING, STARTED, SKIPPED, CANCELED
  jobId      String?         @unique
  reason     String?
  reviewedAt DateTime?
  createdAt  DateTime        @default(now())
  startedAt  DateTime?
  updatedAt  DateTime        @updatedAt
  site       Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  job        AiWorkbenchJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  @@unique([siteId, dedupeKey])
  @@index([status, priority, createdAt])
  @@index([siteId, createdAt])
}

/// A Manus task from a research template other than keyword research
/// (lib/manus/research.ts): GEO citation sources or link prospects. Its
/// result comes back as structured rows (Manus API v2 structured output).
model ManusResearchTask {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
  requestId String
  kind      String   // GEO_SOURCES or LINK_PROSPECTS
  input     Json
  status    String   // submitting, unknown, pending, running, waiting, completed, failed
  remoteId  String?
  taskUrl   String?
  summary   String?
  rows      Json     @default("[]")
  /// Whether Manus extracted the structured result: null until the task finished.
  extracted Boolean?
  errorCode String?
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId, requestId])
  @@index([userId, siteId, kind, createdAt, id])
}

model ManusKeywordPreview {
  taskId   String           @id
  source   String
  filename String
  rows     Json
  revision Int              @default(1)
  task     ManusKeywordTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model GeoSnapshot {
  siteId    String
  kind      String // GA4, BOT, PROBE (live access check), GSC_AI, BING_AI (imported AI reports)
  report    Json
  updatedAt DateTime
  site      Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, kind])
}

// ============ GEO PROMPT TRACKING (lib/geo/tracking.ts) ============

/// Prompt tracking settings of a site: whose brand to look for in AI answers,
/// which platforms to ask through DataForSEO, how often, and the most one run
/// may spend.
model GeoTracking {
  siteId       String   @id
  brands       Json     // { own: {name, aliases, domains}, competitors: [...] }
  platforms    String[] // GeoPlatformId values asked through DataForSEO
  scheduleDays Int?     // null: runs only when started by hand
  budgetUsd    Float    @default(1)
  samples      Int      @default(1) // answers asked per prompt and platform in one run (1-5)
  facts        Json?    // brand fact card: [{label, value}], checked against answers
  updatedAt    DateTime @updatedAt
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model GeoPrompt {
  id        String      @id @default(cuid())
  siteId    String
  text      String
  tag       String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  answers   GeoAnswer[]

  @@unique([siteId, text])
}

/// One tracking run: every active prompt on every chosen platform, as one job.
model GeoRun {
  id         String      @id @default(cuid())
  siteId     String
  jobId      String?     @unique // the job that runs it; a retry of that job resumes the run
  source     String      // manual or schedule
  status     String      // RUNNING, SUCCEEDED, PARTIAL, FAILED
  plan       Json        // { prompts: [id], platforms: [id], market: {language, location} }
  planned    Int
  done       Int         @default(0)
  failed     Int         @default(0)
  costUsd    Float       @default(0)
  budgetUsd  Float
  summary    Json?       // per platform, analysed with the brand settings of the time
  error      String?
  errorCode  String?
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  answers    GeoAnswer[]

  @@index([siteId, startedAt])
}

/// One AI answer to one prompt on one platform: fetched in a run, or recorded by hand (runId null).
model GeoAnswer {
  id        String    @id @default(cuid())
  siteId    String
  runId     String?
  promptId  String
  platform  String
  source    String    // DATAFORSEO or MANUAL
  status    String    // OK, NO_ANSWER (the platform gave no AI answer), FAILED
  text      String?   // the answer, at most 20,000 characters
  citations Json      // [{url, domain, title, rank}]
  meta      Json?     // model, sources consulted, fan-out queries, organic rank
  costUsd   Float     @default(0)
  error     String?
  sample    Int       @default(0) // 0-based answer number within a run (GeoTracking.samples)
  review    Json?     // reviewer labels: {accuracy, sentiment, note, reviewedAt}
  createdAt DateTime  @default(now())
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  run       GeoRun?   @relation(fields: [runId], references: [id], onDelete: Cascade)
  prompt    GeoPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([runId, promptId, platform, sample])
  @@index([siteId, createdAt])
  @@index([promptId, platform, createdAt])
}

// ============ INDEXNOW ============

// One site's IndexNow key and the result of the last submission
// (lib/indexnow/indexnow.ts). The key is public by design: it is served
// at https://<domain>/<key>.txt so search engines can verify submissions.
// External pages an AI draft of this site may cite (lib/ai-workbench/trusted-sources.ts).
// Exact pages, not whole domains: a draft cannot open pages to check a deep link.
model TrustedSource {
  id         String    @id @default(cuid())
  siteId     String
  url        String    // normalized: http(s), no fragment or tracking parameters
  title      String?
  note       String?
  checkedAt  DateTime? // when the owner last had the page fetched
  lastStatus Int?      // HTTP status of that fetch; null when it could not be reached
  createdAt  DateTime  @default(now())
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url])
  @@index([siteId, createdAt])
}

model IndexNowState {
  siteId          String    @id
  key             String
  verifiedAt      DateTime? // when the key file last answered with the key
  lastSubmittedAt DateTime?
  lastStatus      Int?      // HTTP status IndexNow answered with
  lastCount       Int?      // URLs in the last submission
  lastMessage     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum ContentFunnel {
  TOFU
  MOFU
  BOFU
}

enum ContentStatus {
  PLANNED
  BRIEF_READY
  WRITING
  REVIEW
  PUBLISHED
}

enum ContentSource {
  MANUAL
  AI
  EXAMPLE
}

enum ContentJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model ContentPillar {
  id String @id @default(cuid())
  siteId String
  title String
  keyword String
  description String @default("")
  audience String @default("")
  goal String @default("")
  url String?
  source ContentSource @default(MANUAL)
  seedKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  clusters ContentCluster[]
  jobs ContentPlanJob[]
  @@unique([siteId, seedKey])
  @@index([siteId, createdAt])
}

model ContentCluster {
  id String @id @default(cuid())
  siteId String
  pillarId String
  title String
  keyword String
  dedupeKey String
  funnel ContentFunnel
  intent String @default("")
  contentType String @default("Guide")
  status ContentStatus @default(PLANNED)
  url String?
  scheduledFor DateTime?
  optimization Json?
  brief Json?
  source ContentSource @default(MANUAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pillar ContentPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  @@unique([pillarId, dedupeKey])
  @@index([siteId, status])
}

model ContentPlanJob {
  hostedDeviceId String?
  usage Json?
  kind String @default("PLAN")
  request Json?
  id String @id @default(cuid())
  siteId String
  pillarId String
  status ContentJobStatus @default(QUEUED)
  topicCount Int @default(9)
  result Json?
  context Json?
  error String?
  activeKey String? @unique
  appliedAt DateTime?
  leaseToken String?
  leaseExpiresAt DateTime?
  executionAuthorizedAt DateTime?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pillar ContentPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  @@index([siteId, createdAt])
  @@index([status, createdAt])
}

model ContentWorkerState {
  id String @id
  lastSeenAt DateTime @default(now())
  limits Json?        // the worker's last reading of its Codex allowance (lib/ai-workbench/pool/limits.ts)
  limitsAt DateTime?  // when it was read
  limitsError String? // why the last reading failed, if it did
  models Json?        // models this Codex account offers, for per-task routing
  capabilities String[] @default([]) // "routing-v1": takes a model and reasoning effort per task
}

model ChatGptHost {
  id String @id
  hostId String @unique
}

model ChatGptProfile {
  id String @id @default(cuid())
  userId String
  clientId String?
  subject String?
  email String?
  encryptedTokens String? @db.Text
  scopes String[] @default([])
  expiresAt DateTime?
  selected Boolean @default(false)
  epoch Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts ChatGptLoginAttempt[]
  @@index([userId, createdAt])
}

model ChatGptLoginAttempt {
  stateHash String @id
  userId String
  profileId String
  epoch Int
  encryptedPending String @db.Text
  expiresAt DateTime
  returnPath String
  profile ChatGptProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model ChatGptInference {
  jobId String @id
  createdAt DateTime @default(now())
  job AiWorkbenchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model AiWorkbenchJob {
  hostedDeviceId String?
  usage Json?
  id String @id
  siteId String
  kind String
  title String
  status ContentJobStatus @default(QUEUED)
  request Json
  context Json
  result Json?
  draftText String? @db.Text
  error String?
  activeKey String? @unique
  leaseToken String?
  leaseExpiresAt DateTime?
  executionAuthorizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startedAt DateTime?
  finishedAt DateTime?
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  appInference ChatGptInference?
  backlogItem AiBacklogItem?
  @@index([siteId, createdAt])
  @@index([status, createdAt])
}

// ============ GSC DATA ============

model Keyword {
  id          String   @id @default(cuid())
  siteId      String
  query       String   // The search query
  date        DateTime // Date of the data point
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  page        String?  // Landing page URL
  device      String?  // DESKTOP, MOBILE, TABLET
  country     String?  // Country code

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

model Page {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, date])
  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ BING WEBMASTER DATA ============

/// Bing's daily grain: site traffic (GetRankAndTrafficStats) and crawler stats
/// (GetCrawlStats) share one row because both are keyed by (site, day).
/// Kept apart from Keyword/Page so no existing Google query changes meaning.
model BingDaily {
  id              String   @id @default(cuid())
  siteId          String
  date            DateTime
  clicks          Int?
  impressions     Int?
  crawledPages    Int?
  inIndex         Int?
  inLinks         Int?
  code2xx         Int?
  code301         Int?
  code302         Int?
  code4xx         Int?
  code5xx         Int?
  blockedByRobots Int?
  crawlErrors     Int?

  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
}

/// Bing's weekly grain: GetQueryStats and GetPageStats return the same contract
/// in buckets ending on a Friday, so `kind` distinguishes them.
model BingSearchWeekly {
  id                    String   @id @default(cuid())
  siteId                String
  kind                  String   // "query" | "page"
  key                   String   // the search query, or the page URL
  weekEnding            DateTime
  clicks                Int?     // null when Bing left the counter out
  impressions           Int?
  avgImpressionPosition Float?

  site                  Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, kind, key, weekEnding])
  @@index([siteId, kind, weekEnding])
}

// ============ SAVED KEYWORDS ============

model SavedKeyword {
  id        String   @id @default(cuid())
  siteId    String
  query     String
  notes     String?
  /// Checked by rank tracking (lib/rank-tracking): its measured Google position.
  tracked   Boolean  @default(false)
  createdAt DateTime @default(now())

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query])
  @@index([siteId])
}

// ============ RANK TRACKING ============

model RankSnapshot {
  id          String   @id @default(cuid())
  siteId      String
  query       String
  position    Float
  clicks      Int      @default(0)
  impressions Int      @default(0)
  page        String?
  date        DateTime

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

/// Rank tracking settings of a site (lib/rank-tracking/tracking.ts): how its
/// tracked saved keywords are checked on Google through DataForSEO's standard
/// queue, how often, and the most one run may spend. The market is the site's
/// research market.
model RankTracking {
  siteId       String   @id
  device       String   @default("desktop") // desktop or mobile
  depth        Int      @default(30)        // results read per keyword, billed per page of 10
  aiOverview   Boolean  @default(false)     // also load Google's AI Overview (extra charge per keyword)
  scheduleDays Int?     // null: runs only when started by hand
  budgetUsd    Float    @default(1)
  updatedAt    DateTime @updatedAt
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

/// One rank check run: its tasks are posted to DataForSEO's standard queue,
/// then collected by later jobs (lib/rank-tracking/job.ts) until all are back.
model RankRun {
  id         String      @id @default(cuid())
  siteId     String
  jobId      String?     @unique // the job that posts it; a retry of that job resumes the run
  source     String      // manual or schedule
  status     String      // POSTING, WAITING, SUCCEEDED, PARTIAL, FAILED
  device     String
  depth      Int
  aiOverview Boolean     @default(false)
  language   String
  location   Int
  planned    Int
  done       Int         @default(0)
  failed     Int         @default(0)
  costUsd    Float       @default(0)
  budgetUsd  Float
  error      String?
  errorCode  String?
  startedAt  DateTime    @default(now())
  postedAt   DateTime?
  finishedAt DateTime?
  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  checks     RankCheck[]

  @@index([siteId, startedAt])
}

/// One keyword checked in one run: where the site ranks in Google's organic
/// results, which page ranks, and the first ten results.
model RankCheck {
  id         String    @id @default(cuid())
  siteId     String
  runId      String
  keyword    String    // the saved keyword's text when the run started
  remoteId   String?   // DataForSEO task id, once posted
  status     String    // QUEUED (not posted yet), PENDING (posted), OK, FAILED
  position   Int?      // organic rank (rank_group) of the site's first result; null: not within depth
  absolute   Int?      // rank_absolute: counting every element on the results page
  url        String?   // the site's page at that position
  aiOverview Boolean?  // the results page showed an AI Overview; null: unknown
  aiCited    Boolean?  // the AI Overview cites the site; null: not loaded
  features   String[]  // other result types on the page (featured_snippet, people_also_ask, ...)
  top        Json      @default("[]") // first ten organic results: [{rank, domain, url, title}]
  costUsd    Float     @default(0)
  error      String?
  checkedAt  DateTime? // when Google's results were read
  createdAt  DateTime  @default(now())
  run        RankRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([runId, keyword])
  @@index([siteId, keyword, createdAt])
  @@index([remoteId])
}

// ============ CRAWLER ============

model Crawl {
  id          String      @id @default(cuid())
  siteId      String
  status      CrawlStatus @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?
  pagesFound  Int         @default(0)
  issuesFound Int         @default(0)
  healthScore Int?        // 0-100
  // How healthScore was computed (lib/crawler/audit-policy.ts). Null: the legacy 8/3/1 deduction.
  healthScoreVersion String?
  maxPages    Int         @default(200)
  // Set when the crawl is created and each time it makes progress. A RUNNING
  // crawl that stops updating it was interrupted.
  lastProgressAt DateTime?
  error       String?     // why a FAILED crawl failed

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  issues      CrawlIssue[]
  auditPages  AuditPage[]
  auditLinks  AuditLink[]
  jobs        Job[]

  @@index([siteId, startedAt])
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============ AUDIT PAGE DATA ============

model AuditPage {
  articleText String?
  articleHeadings Json?
  id              String  @id @default(cuid())
  crawlId         String
  url             String
  statusCode      Int
  redirectUrl     String?

  title           String?
  description     String?
  canonical       String?
  robotsMeta      String?

  h1Count         Int     @default(0)
  h1s             Json?   // Array of H1 text
  wordCount       Int     @default(0)

  imageCount      Int     @default(0)
  imagesMissingAlt Int    @default(0)

  internalLinks   Int     @default(0)
  externalLinks   Int     @default(0)

  hasSchema       Boolean @default(false)
  schemaReport    Json?   // Bounded captured JSON-LD checks; null means not checked.
  hreflangTags    Json?   // Array of hreflang values

  contentScore    Int     @default(0)  // 0-100
  contentHash     String? // SHA-256 of body text

  responseTimeMs  Int     @default(0)
  byteSize        Int     @default(0)
  // False when the page is noindex: meta robots/googlebot or X-Robots-Tag.
  // Such a page is crawled and its links followed, but it is kept out of the
  // health score and the issues.
  indexable       Boolean @default(true)
  noindexSource   String? // "meta", "x-robots-tag" or both, comma-joined
  xRobotsTag      String? // the X-Robots-Tag header lines as received, newline-separated
  // Robots-type meta tags ([name, content], robots/googlebot/bingbot/msnbot)
  // and whether a data-nosnippet attribute is present; null on older crawls.
  robotsDirectives Json?
  // GEO readiness evidence (lib/crawler/geo-signals.ts): cited sources,
  // app-shell detection and declared dates; null on older crawls.
  geoSignals      Json?

  crawl           Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, url])
}

// ============ AUDIT LINK GRAPH ============

model AuditLink {
  id          String  @id @default(cuid())
  crawlId     String
  sourceUrl   String
  targetUrl   String
  anchorText  String?
  isInternal  Boolean @default(true)
  isNofollow  Boolean @default(false)
  statusCode  Int?

  crawl       Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, sourceUrl])
}

model CrawlIssue {
  id          String        @id @default(cuid())
  crawlId     String
  url         String
  type        IssueType
  severity    IssueSeverity
  message     String
  details     Json?         // Additional context

  crawl       Crawl         @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId, type])
}

enum IssueType {
  BROKEN_LINK           // 404, 500, etc.
  REDIRECT              // 301, 302 chains
  MISSING_TITLE         // No <title> tag
  MISSING_DESCRIPTION   // No meta description
  DUPLICATE_TITLE       // Same title on multiple pages
  DUPLICATE_DESCRIPTION // Same description on multiple pages
  MISSING_H1            // No H1 heading
  MULTIPLE_H1           // More than one H1
  MISSING_ALT           // Images without alt text
  MISSING_CANONICAL     // No canonical tag
  MISSING_ROBOTS        // No robots.txt
  MISSING_SITEMAP       // No sitemap.xml
  MISSING_SCHEMA        // No structured data
  SLOW_PAGE             // Load time > 3s
  MIXED_CONTENT         // HTTP resources on HTTPS page
  LARGE_PAGE            // Page size > 3MB
  HREFLANG              // Invalid codes, missing self or return links, alternates that redirect
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

// ============ CORE WEB VITALS ============

model VitalsReport {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime @default(now())
  device      String   // MOBILE or DESKTOP

  // Core Web Vitals
  lcp         Float?   // Largest Contentful Paint (seconds)
  fid         Float?   // First Input Delay (milliseconds)
  cls         Float?   // Cumulative Layout Shift (score)
  inp         Float?   // Interaction to Next Paint (milliseconds)

  // Performance
  perfScore   Int?     // 0-100 Lighthouse performance score
  speedIndex  Float?   // Speed Index (seconds)
  ttfb        Float?   // Time to First Byte (seconds)
  tbt         Float?   // Total Blocking Time (milliseconds, lab); Lighthouse cannot measure INP

  // Field data: Chrome UX Report p75 over the last 28 days, from the same
  // PageSpeed Insights response. Null when Chrome has too few visits.
  fieldSource   String? // URL (this page) or ORIGIN (the whole site, as a fallback)
  fieldLcp      Float?  // seconds
  fieldInp      Float?  // milliseconds
  fieldCls      Float?  // score
  fieldCategory String? // FAST, AVERAGE or SLOW, as PageSpeed Insights reports it

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ ALERTS ============

model Alert {
  id          String     @id @default(cuid())
  userId      String
  siteId      String
  type        AlertType
  channel     AlertChannel
  config      Json       // Thresholds, webhook URL, etc.
  enabled     Boolean    @default(true)
  lastFired   DateTime?
  createdAt   DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum AlertType {
  TRAFFIC_DROP       // Clicks dropped > X%
  POSITION_CHANGE    // Keyword position changed > X
  NEW_404            // New broken links detected
  VITALS_DEGRADED    // Core Web Vitals got worse
  CRAWL_ISSUES       // New crawl issues detected
  NOINDEX_SITEWIDE   // Most fetched pages of the latest crawl are noindex
  RANK_DROP          // A tracked keyword fell X places or off the first page in the latest rank check
}

enum AlertChannel {
  EMAIL
  TELEGRAM
  WEBHOOK
  SLACK
}

// ============================================
// JOB QUEUE (lib/jobs)
// ============================================

// Background work: crawls, vitals checks, syncs, alert evaluation. Claimed by
// the app (WORKER_MODE=inline) or the worker process with FOR UPDATE SKIP
// LOCKED, retried with backoff, and taken back when the process running it
// stops sending heartbeats.
model Job {
  hostedDeviceId String?
  id          String    @id @default(cuid())
  siteId      String
  type        String    // a type registered in lib/jobs/handlers.ts
  status      JobStatus @default(QUEUED)
  source      String    // "manual" | "mcp" | "schedule" | "chain" | "site-added"
  priority    Int       @default(0) // higher runs first
  payload     Json?
  result      Json?
  attempts    Int       @default(0)
  maxAttempts Int
  runAt       DateTime  @default(now()) // not before
  activeKey   String?   @unique // "<type>:<siteId>" while QUEUED or RUNNING, null once finished
  lockedBy    String?   // id of the process running it
  lockedAt    DateTime?
  heartbeatAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  errorCode   String?   // e.g. REAUTH_REQUIRED, QUOTA_EXCEEDED
  crawlId     String?   // the crawl row of the latest attempt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawl       Crawl?    @relation(fields: [crawlId], references: [id], onDelete: SetNull)

  @@index([status, runAt])
  @@index([siteId, type, createdAt])
  @@index([crawlId])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// One row per process that processes jobs, so the app can tell whether
// anything picks up queued jobs. Holds no user data.
model WorkerHeartbeat {
  id         String   @id // the process id used in Job.lockedBy
  mode       String   // "inline" | "worker"
  hostname   String
  version    String
  startedAt  DateTime
  lastSeenAt DateTime
  managedPolicy String?

  @@index([lastSeenAt])
}


// The scheduler's own timestamps (lib/jobs/scheduler.ts). Holds no user data.
// "firstSeenAt:<type>": the first pass that could schedule that job type; a
// site's first scheduled crawl and vitals check are spread over the interval
// after it. "lastRunAt": the last scheduling pass, so processes share one.
model SchedulerState {
  key String   @id
  at  DateTime
}

// Successful retrieval of API-reported data, including zero-row dates.
// Legacy records have no coverage evidence until a successful refresh.
model GscSyncCoverage {
  id String @id @default(cuid())
  siteId String
  date DateTime
  gscProperty String
  pagesComplete Boolean @default(false)
  queryPagesComplete Boolean @default(false)
  propertyChecked Boolean @default(false)
  propertyClicks Int?
  propertyImpressions Int?
  propertyPosition Float?
  syncedAt DateTime @default(now())
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@unique([siteId, date])
  @@index([siteId, date])
}

model QueryPage {
  id String @id @default(cuid())
  siteId String
  query String
  page String
  date DateTime
  clicks Int @default(0)
  impressions Int @default(0)
  ctr Float @default(0)
  position Float @default(0)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@unique([siteId, query, page, date])
  @@index([siteId, date])
}
