ABORDER_CONTROL_HOST=manage.example.com
ABORDER_CONTROL_SIGNING_KID=production-1
ABORDER_CONTROL_LEASE_SECONDS=900
# Optional for an issuer-preserving public-origin migration:
# ABORDER_CONTROL_ISSUER=https://original-management.example.com
# Optional hosted workbench listener (direct loopback only; never proxy publicly):
# ABORDER_CONTROL_INTERNAL_SECRET=<independently-generated-32-byte-base64url-secret>
# ABORDER_CONTROL_INTERNAL_BIND=127.0.0.1
# ABORDER_CONTROL_INTERNAL_PORT=18086
