# A-Border SEO 本地部署配置
# 第一次运行 配置Google.cmd 时会据此生成 .env，并自动填好随机的数据库密码和应用密钥。

# 应用镜像。构建镜像.cmd 会按源码版本自动改这一行
ABORDER_SEO_IMAGE=a-border-seo:1.1.2

# 本机访问端口（http://localhost:3300）。改端口时，同时改下面的 NEXTAUTH_URL，
# 并在 Google OAuth 客户端里添加新的回调地址
LOCAL_APP_PORT=3300

# 本项目独立的数据库。第一次启动后不要再改这三项
POSTGRES_USER=aborder
POSTGRES_DB=aborder
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
# 可选：改用指定名称的数据卷（默认 aborder-seo-local_pgdata）
# ABORDER_DB_VOLUME=

# Google OAuth：运行 配置Google.cmd 在本机输入
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# 后台地址与应用密钥。NEXTAUTH_SECRET 同时加密保存的 Google 令牌和 API Key，生成后不要更改
NEXTAUTH_URL=http://localhost:3300
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET
AUTH_TRUST_HOST=true

# 用自己的 Google 账号首次登录后，运行 关闭新用户注册.cmd
DISABLE_REGISTRATION=false

# 先做小规模验证
CRAWL_MAX_PAGES=500
CRAWL_MAX_MINUTES=20
# 保留最近几次抓取的页面正文、标题结构和结构化数据明细（2 到 100）
CRAWL_DETAIL_RETENTION=3
WORKER_LONG_CONCURRENCY=1
WORKER_SHORT_CONCURRENCY=1
API_RATE_LIMIT_PER_MINUTE=60

# 初期关闭自动采集，手动验证后再打开
SCHEDULER_ENABLED=false
SCHEDULE_GSC_SYNC_HOURS=24
SCHEDULE_BING_SYNC_HOURS=24
SCHEDULE_CRAWL_DAYS=7
SCHEDULE_VITALS_DAYS=7
# 提示词跟踪的定期运行：各站点在 GEO 监测中设置间隔；需要先把上面的 SCHEDULER_ENABLED 改为 true
SCHEDULE_GEO_TRACKING=true

# 初期不启用外部告警回调
ALERT_WEBHOOKS_ENABLED=false

# 本地内容 Worker 的令牌：由 设置内容Worker.cmd 生成并写在这里
# LOCAL_CONTENT_WORKER_TOKEN=

# 可选：访问 Google 需要走本机代理时填写。容器里要用 host.docker.internal 访问本机，
# 例如 http://host.docker.internal:7890（不能带用户名、密码或路径）
# GOOGLE_HTTP_PROXY=
# Optional local proxy for ChatGPT account authorization, models and requests.
# OPENAI_HTTP_PROXY=http://host.docker.internal:7890
# 可选：仅用于连接 Manus 官方 API。研究所用的密钥在工作台的连接设置中保存。
# MANUS_HTTP_PROXY=http://host.docker.internal:7890

# 可选：抓取时使用的 User-Agent。第一个“/”之前的产品标识用于匹配 robots.txt，建议保留
# CRAWLER_USER_AGENT=ABorderSEOBot/1.0 (+https://your-site.example/bot)

# 可选：侧边栏的新版本提示。填写发布版本的 GitHub 仓库（owner/name）后，每天查询一次；不填不查询
# UPDATE_CHECK_REPO=

# 可选：页面性能接口（PageSpeed Insights）配额
# GOOGLE_PAGESPEED_KEY=
